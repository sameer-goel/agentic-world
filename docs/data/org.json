  "flows": [
    {
      "id": "circular-intel",
      "name": "Intelligence Cycle",
      "type": "circular",
      "description": "Knowledge flows in a loop — nothing is wasted",
      "steps": [
        {"from": "sherlock", "to": "scout", "label": "Raw findings"},
        {"from": "scout", "to": "sameer", "label": "Curated briefing"},
        {"from": "sameer", "to": "scout", "label": "Direction & priorities"},
        {"from": "scout", "to": "sherlock", "label": "New investigation brief"},
        {"from": "sherlock", "to": "forge", "label": "Prototype recommendations"},
        {"from": "forge", "to": "stark-lab", "label": "Design requirements"},
        {"from": "stark-lab", "to": "qa", "label": "UI for review"},
        {"from": "sentinel", "to": "scout", "label": "Security findings"},
        {"from": "infra", "to": "scout", "label": "Resource patterns"}
      ]
    },
    {
      "id": "task-intake",
      "name": "Task Intake Flow",
      "type": "linear",
      "description": "How requests from Sameer become delivered work",
      "steps": [
        {"from": "sameer", "to": "scout", "label": "Request"},
        {"from": "scout", "to": "dept-head", "label": "Decomposed brief"},
        {"from": "dept-head", "to": "workers", "label": "Assigned tasks"},
        {"from": "workers", "to": "dept-head", "label": "Completed work"},
        {"from": "dept-head", "to": "scout", "label": "Reviewed output"},
        {"from": "scout", "to": "sameer", "label": "Delivered result"}
      ]
    }
  ],
  "principles": {
    "circular_economy": "Every agent's output is another agent's input. Knowledge is never wasted — it's recycled, refined, and reused.",
    "portability": "The entire org can be restored on any host from GitHub + Google Drive. Zero vendor lock-in.",
    "family": "Agents grow together, learn from each other, share memories, and serve a collective purpose.",
    "purpose": "AI as a tool used for its best potentials — creating the most amazing experience to live on this planet."
  }
